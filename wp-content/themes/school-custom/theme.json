{
    "$schema": "https://schemas.wp.org/wp/7.1/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "color": {
            "defaultDuotone": false,
            "defaultGradients": true,
            "defaultPalette": true,
            "palette": [
                {
                    "color": "#003C71",
                    "name": "School Blue",
                    "slug": "primary"
                },
                {
                    "color": "#FFFFFF",
                    "name": "White",
                    "slug": "base"
                },
                {
                    "color": "#444444",
                    "name": "Dark Text",
                    "slug": "contrast"
                },
                {
                    "color": "#F2F6FA",
                    "name": "Light Blue Background",
                    "slug": "surface"
                },
                {
                    "color": "#71003C",
                    "name": "Button Burgundy",
                    "slug": "button"
                },
                {
                    "color": "#71003c",
                    "name": "Accent",
                    "slug": "accent"
                },
                {
                    "color": "#0057a4",
                    "name": "Hover",
                    "slug": "hover"
                }
            ]
        },
        "layout": {
            "contentSize": "50rem",
            "wideSize": "62.5rem"
        },
        "spacing": {
            "defaultSpacingSizes": false,
            "spacingSizes": [
                {
                    "name": "Tiny",
                    "size": "0.44rem",
                    "slug": "20"
                },
                {
                    "name": "X-Small",
                    "size": "0.67rem",
                    "slug": "30"
                },
                {
                    "name": "Small",
                    "size": "1rem",
                    "slug": "40"
                },
                {
                    "name": "Regular",
                    "size": "1.5rem",
                    "slug": "50"
                },
                {
                    "name": "Large",
                    "size": "2.25rem",
                    "slug": "60"
                },
                {
                    "name": "X-Large",
                    "size": "3.38rem",
                    "slug": "70"
                },
                {
                    "name": "XX-Large",
                    "size": "5.06rem",
                    "slug": "80"
                }
            ],
            "units": [
                "%",
                "px",
                "em",
                "rem",
                "vh",
                "vw"
            ]
        },
        "typography": {
            "defaultFontSizes": false,
            "fluid": true,
            "fontFamilies": [
                {
                    "name": "System Font",
                    "slug": "system-font",
                    "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif"
                },
                {
                    "name": "Noto Sans",
                    "slug": "noto-sans",
                    "fontFamily": "\"Noto Sans\", sans-serif"
                },
                {
                    "name": "Noto Serif",
                    "slug": "noto-serif",
                    "fontFamily": "\"Noto Serif\", serif"
                }
            ],
            "fontSizes": [
                {
                    "fluid": false,
                    "name": "Small",
                    "size": "clamp(1rem, 1rem + ((1vw - 0.2rem) * 0.306), 1.13rem)",
                    "slug": "small"
                },
                {
                    "fluid": false,
                    "name": "Medium",
                    "size": "clamp(1.19rem, 1.19rem + ((1vw - 0.2rem) * 0.141), 1.25rem)",
                    "slug": "medium"
                },
                {
                    "fluid": false,
                    "name": "Large",
                    "size": "clamp(1.25rem, 1.25rem + ((1vw - 0.2rem) * 1.176), 1.75rem)",
                    "slug": "large"
                },
                {
                    "fluid": false,
                    "name": "Extra Large",
                    "size": "clamp(1.75rem, 1.75rem + ((1vw - 0.2rem) * 1.176), 2.25rem)",
                    "slug": "x-large"
                },
                {
                    "fluid": {
                        "max": "3rem",
                        "min": "2.25rem"
                    },
                    "name": "Extra Extra Large",
                    "size": "3rem",
                    "slug": "xx-large"
                }
            ],
            "writingMode": true
        },
        "useRootPaddingAwareAlignments": true,
        "shadow": {
            "defaultPresets": true,
            "presets": [
                {
                    "name": "Shadow 1",
                    "slug": "shadow-1",
                    "shadow": "6px 6px 0px -3px #ffffff, 6px 6px 0px 0 #71003c"
                }
            ]
        }
    },
    "styles": {
        "blocks": {
            "core/button": {
                "border": {
                    "radius": "999px"
                },
                "color": {
                    "background": "var:preset|color|primary",
                    "text": "var:preset|color|base"
                },
                "spacing": {
                    "padding": {
                        "bottom": "0.75rem",
                        "left": "clamp(1rem, 3vw, 2rem)",
                        "right": "clamp(1rem, 3vw, 2rem)",
                        "top": "0.75rem"
                    }
                }
            },
            "core/heading": {
                "color": {
                    "text": "var(--wp--preset--color--primary)"
                }
            },
            "core/pullquote": {
                "typography": {
                    "fontSize": "clamp(0.984em, 0.984rem + ((1vw - 0.2em) * 1.214), 1.5em)",
                    "lineHeight": "1.6"
                }
            },
            "core/quote": {
                "color": {
                    "background": "var(--wp--preset--color--surface)",
                    "text": "var(--wp--preset--color--contrast)"
                },
                "spacing": {
                    "padding": {
                        "bottom": "1.5rem",
                        "left": "1.5rem",
                        "right": "1.5rem",
                        "top": "1.5rem"
                    }
                }
            },
            "core/button": {
                "border": {
                    "radius": "999px"
                }
            },
            "core/heading": {
                "typography": {
                    "lineHeight": "1.2"
                }
            }
        },
        "color": {
            "background": "var(--wp--preset--color--base)",
            "text": "var(--wp--preset--color--contrast)"
        },
        "elements": {
            "h1": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--x-large)"
                }
            },
            "h2": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--large)"
                }
            },
            "h3": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--medium)"
                }
            },
            "heading": {
                "color": {
                    "text": "var(--wp--preset--color--contrast)"
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--noto-sans)",
                    "fontStyle": "normal",
                    "fontWeight": "400",
                    "letterSpacing": "-0.1px",
                    "lineHeight": "1.125"
                }
            },
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--primary)"
                },
                ":hover": {
                    "color": {
                        "text": "var(--wp--preset--color--hover)"
                    }
                }
            },
            "button": {
                "color": {
                    "background": "var(--wp--preset--color--primary)",
                    "text": "var(--wp--preset--color--base)"
                },
                "border": {
                    "width": "0"
                },
                "typography": {
                    "fontFamily": "inherit",
                    "fontSize": "inherit",
                    "fontStyle": "inherit",
                    "fontWeight": "inherit",
                    "letterSpacing": "inherit",
                    "lineHeight": "inherit",
                    "textTransform": "inherit",
                    "textDecoration": "none"
                },
                "spacing": {
                    "padding": {
                        "top": "calc(0.667em + 2px)",
                        "bottom": "calc(0.667em + 2px)",
                        "left": "calc(1.333em + 2px)",
                        "right": "calc(1.333em + 2px)"
                    }
                }
            },
            "h4": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--medium)"
                }
            },
            "h5": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--small)",
                    "letterSpacing": "0.5px"
                }
            },
            "h6": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--small)",
                    "fontWeight": "400",
                    "letterSpacing": "1.4px",
                    "textTransform": "uppercase"
                }
            }
        },
        "spacing": {
            "blockGap": "24px",
            "padding": {
                "top": "0px",
                "right": "1rem",
                "bottom": "0px",
                "left": "1rem"
            }
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--noto-serif)",
            "fontSize": "var(--wp--preset--font-size--small)",
            "fontStyle": "normal",
            "fontWeight": "400",
            "lineHeight": "1.8",
            "letterSpacing": "-0.1px"
        }
    },
    "templateParts": [
        {
            "area": "header",
            "name": "header"
        },
        {
            "area": "footer",
            "name": "footer"
        }
    ]
}