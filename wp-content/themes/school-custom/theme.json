{
    "$schema":  "https://schemas.wp.org/wp/7.1/theme.json",
    "version":  3,
    "settings":  {
                     "appearanceTools":  true,
                     "color":  {
                                   "defaultDuotone":  false,
                                   "defaultGradients":  false,
                                   "defaultPalette":  false,
                                   "palette":  [
                                                   {
                                                       "color":  "#003C71",
                                                       "name":  "School Blue",
                                                       "slug":  "primary"
                                                   },
                                                   {
                                                       "color":  "#FFFFFF",
                                                       "name":  "White",
                                                       "slug":  "base"
                                                   },
                                                   {
                                                       "color":  "#111111",
                                                       "name":  "Dark Text",
                                                       "slug":  "contrast"
                                                   },
                                                   {
                                                       "color":  "#F2F6FA",
                                                       "name":  "Light Blue Background",
                                                       "slug":  "surface"
                                                   },
                                                   {
                                                       "color":  "#71003C",
                                                       "name":  "Button Burgundy",
                                                       "slug":  "button"
                                                   }
                                               ]
                               },
                     "layout":  {
                                    "contentSize":  "52.5rem",
                                    "wideSize":  "75rem"
                                },
                     "spacing":  {
                                     "defaultSpacingSizes":  false,
                                     "spacingSizes":  [
                                                          {
                                                              "name":  "Tiny",
                                                              "size":  "0.625rem",
                                                              "slug":  "20"
                                                          },
                                                          {
                                                              "name":  "X-Small",
                                                              "size":  "clamp(0.75rem, 2vw, 1.25rem)",
                                                              "slug":  "30"
                                                          },
                                                          {
                                                              "name":  "Small",
                                                              "size":  "clamp(1rem, 3vw, 1.875rem)",
                                                              "slug":  "40"
                                                          },
                                                          {
                                                              "name":  "Regular",
                                                              "size":  "clamp(1.5rem, 4vw, 3.125rem)",
                                                              "slug":  "50"
                                                          },
                                                          {
                                                              "name":  "Large",
                                                              "size":  "clamp(1.875rem, 5vw, 4.375rem)",
                                                              "slug":  "60"
                                                          },
                                                          {
                                                              "name":  "X-Large",
                                                              "size":  "clamp(2.5rem, 7vw, 5.625rem)",
                                                              "slug":  "70"
                                                          },
                                                          {
                                                              "name":  "XX-Large",
                                                              "size":  "clamp(3rem, 9vw, 8.75rem)",
                                                              "slug":  "80"
                                                          }
                                                      ],
                                     "units":  [
                                                   "%",
                                                   "px",
                                                   "em",
                                                   "rem",
                                                   "vh",
                                                   "vw"
                                               ]
                                 },
                     "typography":  {
                                        "defaultFontSizes":  false,
                                        "fluid":  true,
                                        "fontFamilies":  [
                                                             {
                                                                 "fontFace":  [
                                                                                  {
                                                                                      "fontFamily":  "\"Open Sans\"",
                                                                                      "fontStyle":  "normal",
                                                                                      "fontWeight":  "400",
                                                                                      "src":  [
                                                                                                  "file:./assets/fonts/open-sans/open-sans-400-normal.woff2"
                                                                                              ]
                                                                                  }
                                                                              ],
                                                                 "fontFamily":  "\"Open Sans\", Arial, sans-serif",
                                                                 "name":  "Open Sans",
                                                                 "slug":  "open-sans"
                                                             },
                                                             {
                                                                 "fontFace":  [
                                                                                  {
                                                                                      "fontFamily":  "Roboto",
                                                                                      "fontStyle":  "normal",
                                                                                      "fontWeight":  "400",
                                                                                      "src":  [
                                                                                                  "file:./assets/fonts/roboto/roboto-400-normal.woff2"
                                                                                              ]
                                                                                  },
                                                                                  {
                                                                                      "fontFamily":  "Roboto",
                                                                                      "fontStyle":  "normal",
                                                                                      "fontWeight":  "700",
                                                                                      "src":  [
                                                                                                  "file:./assets/fonts/roboto/roboto-700-normal.woff2"
                                                                                              ]
                                                                                  }
                                                                              ],
                                                                 "fontFamily":  "Roboto, Arial, sans-serif",
                                                                 "name":  "Roboto",
                                                                 "slug":  "roboto"
                                                             }
                                                         ],
                                        "fontSizes":  [
                                                          {
                                                              "fluid":  false,
                                                              "name":  "Small",
                                                              "size":  "0.875rem",
                                                              "slug":  "small"
                                                          },
                                                          {
                                                              "fluid":  {
                                                                            "max":  "1.125rem",
                                                                            "min":  "1rem"
                                                                        },
                                                              "name":  "Medium",
                                                              "size":  "1.125rem",
                                                              "slug":  "medium"
                                                          },
                                                          {
                                                              "fluid":  {
                                                                            "max":  "1.5rem",
                                                                            "min":  "1.25rem"
                                                                        },
                                                              "name":  "Large",
                                                              "size":  "1.5rem",
                                                              "slug":  "large"
                                                          },
                                                          {
                                                              "fluid":  {
                                                                            "max":  "2.25rem",
                                                                            "min":  "1.75rem"
                                                                        },
                                                              "name":  "Extra Large",
                                                              "size":  "2.25rem",
                                                              "slug":  "x-large"
                                                          },
                                                          {
                                                              "fluid":  {
                                                                            "max":  "3rem",
                                                                            "min":  "2.25rem"
                                                                        },
                                                              "name":  "Extra Extra Large",
                                                              "size":  "3rem",
                                                              "slug":  "xx-large"
                                                          }
                                                      ],
                                        "writingMode":  true
                                    },
                     "useRootPaddingAwareAlignments":  true
                 },
    "styles":  {
                   "blocks":  {
                                  "core/button":  {
                                                      "border":  {
                                                                     "radius":  "999px"
                                                                 },
                                                      "color":  {
                                                                    "background":  "var:preset|color|primary",
                                                                    "text":  "var:preset|color|base"
                                                                },
                                                      "spacing":  {
                                                                      "padding":  {
                                                                                      "bottom":  "0.75rem",
                                                                                      "left":  "clamp(1rem, 3vw, 2rem)",
                                                                                      "right":  "clamp(1rem, 3vw, 2rem)",
                                                                                      "top":  "0.75rem"
                                                                                  }
                                                                  }
                                                  },
                                  "core/heading":  {
                                                       "color":  {
                                                                     "text":  "var(--wp--preset--color--primary)"
                                                                 },
                                                       "typography":  {
                                                                          "fontFamily":  "var(--wp--preset--font-family--open-sans)",
                                                                          "fontWeight":  "400",
                                                                          "lineHeight":  "1.2"
                                                                      }
                                                   },
                                  "core/quote":  {
                                                     "color":  {
                                                                   "background":  "var(--wp--preset--color--surface)",
                                                                   "text":  "var(--wp--preset--color--contrast)"
                                                               },
                                                     "spacing":  {
                                                                     "padding":  {
                                                                                     "bottom":  "1.5rem",
                                                                                     "left":  "1.5rem",
                                                                                     "right":  "1.5rem",
                                                                                     "top":  "1.5rem"
                                                                                 }
                                                                 }
                                                 }
                              },
                   "color":  {
                                 "background":  "var(--wp--preset--color--base)",
                                 "text":  "var(--wp--preset--color--contrast)"
                             },
                   "elements":  {
                                    "h1":  {
                                               "typography":  {
                                                                  "fontSize":  "var(--wp--preset--font-size--xx-large)"
                                                              }
                                           },
                                    "h2":  {
                                               "typography":  {
                                                                  "fontSize":  "var(--wp--preset--font-size--x-large)"
                                                              }
                                           },
                                    "h3":  {
                                               "typography":  {
                                                                  "fontSize":  "var(--wp--preset--font-size--large)"
                                                              }
                                           },
                                    "h4":  {
                                               "typography":  {
                                                                  "fontSize":  "var(--wp--preset--font-size--medium)"
                                                              }
                                           },
                                    "h5":  {
                                               "typography":  {
                                                                  "fontSize":  "var(--wp--preset--font-size--small)",
                                                                  "letterSpacing":  "0.5px"
                                                              }
                                           },
                                    "h6":  {
                                               "typography":  {
                                                                  "fontSize":  "var(--wp--preset--font-size--small)",
                                                                  "fontWeight":  "700",
                                                                  "letterSpacing":  "1.4px",
                                                                  "textTransform":  "uppercase"
                                                              }
                                           },
                                    "heading":  {
                                                    "typography":  {
                                                                       "fontFamily":  "var(--wp--preset--font-family--open-sans)",
                                                                       "fontWeight":  "400",
                                                                       "letterSpacing":  "-0.1px",
                                                                       "lineHeight":  "1.125"
                                                                   }
                                                },
                                    "link":  {
                                                 "color":  {
                                                               "text":  "var(--wp--preset--color--primary)"
                                                           }
                                             }
                                },
                   "spacing":  {
                                   "blockGap":  "1.2rem",
                                   "padding":  {
                                                   "left":  "clamp(1rem, 4vw, 2rem)",
                                                   "right":  "clamp(1rem, 4vw, 2rem)"
                                               }
                               },
                   "typography":  {
                                      "fontFamily":  "var(--wp--preset--font-family--roboto)",
                                      "fontSize":  "var(--wp--preset--font-size--medium)",
                                      "fontWeight":  "400",
                                      "letterSpacing":  "-0.1px",
                                      "lineHeight":  "1.7"
                                  }
               },
    "templateParts":  [
                          {
                              "area":  "header",
                              "name":  "header"
                          },
                          {
                              "area":  "footer",
                              "name":  "footer"
                          }
                      ]
}